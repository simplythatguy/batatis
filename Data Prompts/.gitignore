# Commit research metadata and tools; keep publisher files and raw captures local.
/*
!/.gitignore
!/README.md
!/CITY_CASES.md
!/SOURCE_PACKAGE_AUDIT.md
!/Alberta Jurisdiction Sources.json
!/Alberta Prompt Index.csv
!/Comparative Prompt Index.csv
!/index.csv
!/index.json
!/downloads.csv
!/source_catalogue.jsonl
!/source_gaps.json
!/validation.json
!/Prompt */
/Prompt */*
!/Prompt */prompt.txt
!/Prompt */source.json
!/Prompt */evaluation.json
!/_tools/
/_tools/*
!/_tools/*.py
!/_source_package/
/_source_package/*
!/_source_package/*.json
!/_research/
/_research/*
!/_research/curation_overrides.json
!/_research/assembly_report.json
!/_research/catalogue_validation.json
