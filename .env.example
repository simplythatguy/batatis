# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# OPENAI_API_KEY is server-only. The web bundle must not receive it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Server-only Elephant Decisions credential; never use a VITE_ prefix.
OPENROUTER_API_KEY=
# file (default, local) or postgres. Postgres also needs DATABASE_URL (Neon sslmode=require).
# Hosted runs require BATATIS_STORE=postgres and DATABASE_URL; file storage is local only.
BATATIS_STORE=file
DATABASE_URL=
# BATATIS_CASES=  # optional local sqlite path
# Independent server-only token for the scheduled retention purge. Required on Vercel.
CRON_SECRET=
# Live model calls need both of these. Offline is the default.
BATATIS_LIVE=
# Optional Elephant-only override: 1 enables its free route while BATATIS_LIVE=0
# keeps all other providers off; 0 disables Elephant even when BATATIS_LIVE=1.
BATATIS_LIVE_ELEPHANT=
BATATIS_DAILY_SPEND_CAP_USD=5
BATATIS_LLM_RATE_LIMIT=20
BATATIS_LLM_RATE_WINDOW_SECONDS=600
BATATIS_SEARCH_RATE_LIMIT=60
BATATIS_SEARCH_RATE_WINDOW_SECONDS=600
# Optional private PDF sources for the engine build. Never a public URL. Still sha256-checked.
CODEDB_PDF_URL=
CODEDB_INTENT_PDF_URL=
# CODEDB_SKIP_OFFICIAL=1
# SCC variance form. The engine build fetches the official PDF into codedb/build/.
# SCC_FORM_URL=          # optional private URL, still sha256-checked
# BATATIS_SCC_FORM=      # optional runtime path; default is the build copy
# Web build: API prefix. Defaults to /api.
# VITE_API_BASE=/api
# Jev uses its own credential store (`jev doctor`); set this only if you prefer an env var.
JEV_API_KEY=
RUNWARE_API_KEY=
