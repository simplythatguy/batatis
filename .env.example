# Copy to .env and fill in. .env is git-ignored; never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Live OpenAI stays off unless BATATIS_LIVE=1 as well. Set the key in Vercel only after the spend cap is on dev.
# BATATIS_LIVE=1
# Total cap in USD for every keyed OpenAI call. Default 20. There is no daily cap.
# BATATIS_DAILY_SPEND_CAP_USD is ignored.
# Live mode refuses BATATIS_LLM_PROVIDER=anthropic. Live calls are OpenAI only.
# BATATIS_LLM_PROVIDER=openai
# BATATIS_TOTAL_BUDGET_USD=20
# Per-IP limits. Each window is in memory on one engine instance, not in Postgres.
# POST /identify defaults: 20 requests per 600 seconds.
# BATATIS_LLM_RATE_LIMIT=20
# BATATIS_LLM_RATE_WINDOW_SECONDS=600
# GET /ccmc/search defaults: 60 requests per 600 seconds.
# BATATIS_SEARCH_RATE_LIMIT=60
# BATATIS_SEARCH_RATE_WINDOW_SECONDS=600
# Postgres (Neon) URL for the spend ledger. DATABASE_URL wins; POSTGRES_URL is the fallback.
# DATABASE_URL=
# POSTGRES_URL=
# Jev uses its own credential store (`jev doctor`); set this only if you prefer an env var.
JEV_API_KEY=
RUNWARE_API_KEY=
