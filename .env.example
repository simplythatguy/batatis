# Copy to .env and fill in. .env is git-ignored; never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Jev uses its own credential store (`jev doctor`); set this only if you prefer an env var.
JEV_API_KEY=
RUNWARE_API_KEY=
# Optional private URLs for the Vercel codedb build. Official NRC URLs are tried first.
# The bytes are still checked against the pinned sha256. Do not commit the PDFs or the sqlite.
# CODEDB_PDF_URL=
# CODEDB_INTENT_PDF_URL=
# SCC_FORM_URL=
# Case store. On Vercel this is /tmp/batatis/cases.sqlite (set on the project, not here).
# BATATIS_CASES=
