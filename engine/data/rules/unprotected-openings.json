            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "var": "street_facing_storey"
              },
              true
            ]
          }
        ]
      },
      "message": "A storey facing a street at street level with a limiting distance of {limiting_distance_m} m (not less than 9 m) need not meet Sentence (1), under Sentence 9.10.14.4.(9)."
