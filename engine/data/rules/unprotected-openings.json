  "derived": [
    {
      "name": "halve_limiting_distance",
      "label": "Half the limiting distance is used (slow fire department response, not fully sprinklered)",
      "expr": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "var": "fire_response_over_10_min"
              },
              true
            ]
          },
          {
            "op": "ne",
            "args": [
              {
                "var": "sprinklered"
              },
              "yes"
            ]
          }
        ]
      }
    },
    {
      "name": "limiting_distance_used_m",
      "label": "Limiting distance used (halved under Sentence 9.10.14.3.(1) where it applies)",
      "unit": "m",
      "expr": {
        "op": "if",
        "args": [
          {
            "var": "halve_limiting_distance"
          },
          {
            "op": "div",
            "args": [
              {
                "var": "limiting_distance_m"
              },
              2
            ]
          },
          {
            "var": "limiting_distance_m"
          }
        ]
      }
    },
    {
      "name": "mercantile_row",
      "label": "Mercantile or medium-hazard industrial row",
      "expr": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "var": "occupancy"
              },
              "mercantile"
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "var": "occupancy"
                  },
                  "industrial"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "var": "industrial_hazard"
                  },
                  "medium"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "table_percent",
      "label": "Table 9.10.14.4.-A percentage (lesser column)",
      "unit": "%",
      "expr": {
        "op": "if",
        "args": [
          {
            "var": "mercantile_row"
          },
          {
            "op": "table",
            "table": "Table 9.10.14.4.-A|mercantile and medium-hazard industrial",
            "row": {
              "var": "ebf_area_m2"
            },
            "col": {
              "var": "limiting_distance_used_m"
            },
            "mode": "lesser"
          },
          {
            "op": "table",
            "table": "Table 9.10.14.4.-A|residential, business and personal services, and low-hazard industrial",
            "row": {
              "var": "ebf_area_m2"
            },
            "col": {
              "var": "limiting_distance_used_m"
            },
            "mode": "lesser"
          }
        ]
      }
    },
    {
      "name": "table_limit_m2",
      "label": "Table 9.10.14.4.-A limit",
      "unit": "m²",
      "expr": {
        "op": "div",
        "args": [
          {
            "op": "mul",
            "args": [
              {
                "var": "table_percent"
              },
              {
                "var": "ebf_area_m2"
              }
            ]
          },
          100
        ]
      }
    },
    {
      "name": "square_limit_m2",
      "label": "Clause (c) limit: the limiting distance squared, or half of it for mercantile and medium-hazard industrial (only where the limiting distance is 1.2 m or more)",
      "unit": "m²",
      "expr": {
        "op": "if",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "limiting_distance_used_m"
              },
              1.2
            ]
          },
          {
            "op": "if",
            "args": [
              {
                "var": "mercantile_row"
              },
              {
                "op": "div",
                "args": [
                  {
                    "op": "mul",
                    "args": [
                      {
                        "var": "limiting_distance_used_m"
                      },
                      {
                        "var": "limiting_distance_used_m"
                      }
                    ]
                  },
                  2
                ]
              },
              {
                "op": "mul",
                "args": [
                  {
                    "var": "limiting_distance_used_m"
                  },
                  {
                    "var": "limiting_distance_used_m"
                  }
                ]
              }
            ]
          },
          0
        ]
      }
    },
    {
      "name": "sentence_1_limit_m2",
      "label": "Largest area Sentence (1) permits (Clause (a) or (c))",
      "unit": "m²",
      "expr": {
        "op": "max",
        "args": [
          {
            "var": "table_limit_m2"
          },
          {
            "var": "square_limit_m2"
          }
        ]
      }
    }
  ],
  "outcomes": [
    {
      "id": "not_part9",
      "state": "not_applicable",
      "provision": "1.3.3.3.(1)",
      "when": {
        "op": "or",
        "args": [
          {
            "op": "gt",
            "args": [
              {
                "var": "storeys"
              },
              3
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "var": "building_area_m2"
              },
              600
            ]
          }
        ]
      },
      "message": "This building has more than 3 storeys or a building area over 600 m², so Part 9 does not apply (Div A, Sentence 1.3.3.3.(1)). The Part 3 requirements are not checked here.",
      "if_unknown": "assume",
      "assumption": "Assumed a Part 9 building (3 storeys or less, building area 600 m² or less); the storeys or building area were not stated."
    },
    {
      "id": "house",
      "state": "not_applicable",
      "provision": "9.10.14.1.(1)",
      "when": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "var": "occupancy"
              },
              "single_family"
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "var": "occupancy"
                  },
                  "multi_family"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "var": "dwelling_unit_above_another"
                  },
                  false
                ]
              }
            ]
          }
        ]
      },
      "message": "This is a house or a building with only dwelling units and none above another, so Subsection 9.10.15. applies instead (see the glazed-openings check, Article 9.10.15.4.)."
    },
    {
      "id": "occupancy_not_in_table",
      "state": "not_applicable",
      "provision": "9.10.14.4.(1)",
      "when": {
        "op": "not",
        "args": [
          {
            "op": "in",
            "args": [
              {
                "var": "occupancy"
              },
              [
                "multi_family",
                "hotel",
                "business",
                "mercantile",
                "industrial"
              ]
            ]
          }
        ]
      },
      "message": "Table 9.10.14.4.-A covers residential, business and personal services, mercantile, and low- and medium-hazard industrial occupancies. This occupancy is not checked here."
    },
    {
      "id": "high_hazard",
      "state": "not_applicable",
      "provision": "1.3.3.3.(1)",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "var": "occupancy"
              },
              "industrial"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "var": "industrial_hazard"
              },
              "high"
            ]
          }
        ]
      },
      "message": "High-hazard industrial occupancies are outside Part 9 (Div A, Sentence 1.3.3.3.(1)); this check does not apply."
    },
    {
      "id": "follows_table",
      "state": "follows",
      "provision": "9.10.14.4.(1)",
      "when": {
        "op": "le",
        "args": [
          {
            "var": "opening_area_m2"
          },
          {
            "var": "table_limit_m2"
          }
        ]
      },
      "message": "Unprotected openings of {opening_area_m2} m² in a {ebf_area_m2} m² exposing building face at a limiting distance of {limiting_distance_used_m} m are within Table 9.10.14.4.-A ({table_percent}%, {table_limit_m2} m²). This follows the acceptable solution in Clause 9.10.14.4.(1)(a)."
    },
    {
      "id": "follows_square",
      "state": "follows",
      "provision": "9.10.14.4.(1)",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "limiting_distance_used_m"
              },
              1.2
            ]
          },
          {
            "op": "le",
            "args": [
              {
                "var": "opening_area_m2"
              },
              {
                "var": "square_limit_m2"
              }
            ]
          }
        ]
      },
      "message": "Unprotected openings of {opening_area_m2} m² are within the Clause (c) limit of {square_limit_m2} m² at a limiting distance of {limiting_distance_used_m} m. This follows the acceptable solution in Clause 9.10.14.4.(1)(c)."
    },
    {
      "id": "follows_wired_glass",
      "state": "follows",
      "provision": "9.10.14.4.(6)",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "le",
            "args": [
              {
                "var": "opening_area_m2"
              },
              {
                "op": "mul",
                "args": [
                  2,
                  {
                    "var": "sentence_1_limit_m2"
                  }
                ]
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "var": "wired_glass_or_glass_block"
              },
              true
            ]
          }
        ]
      },
      "message": "The openings are wired glass in steel frames or glass blocks and are within twice the Sentence (1) limit ({sentence_1_limit_m2} m²), which Sentence 9.10.14.4.(6) permits."
    },
    {
      "id": "follows_sprinklered",
      "state": "follows",
      "provision": "9.10.14.4.(7)",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "le",
            "args": [
              {
                "var": "opening_area_m2"
              },
              {
                "op": "mul",
                "args": [
                  2,
                  {
                    "var": "sentence_1_limit_m2"
                  }
                ]
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "var": "sprinklered"
              },
              "yes"
            ]
          },
          {
            "op": "eq",
            "args": [
