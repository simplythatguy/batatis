              3
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "var": "open_air_storage_garage"
              },
              true
            ]
          }
        ]
      },
      "message": "An open-air storage garage with a limiting distance of {limiting_distance_m} m (not less than 3 m) need not meet Sentence (1), under Sentence 9.10.14.4.(8)."
