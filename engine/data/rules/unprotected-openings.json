              },
              true
            ]
          }
        ]
      },
      "message": "The building is sprinklered, every room behind the wall with openings is sprinklered, and the openings are within twice the Sentence (1) limit ({sentence_1_limit_m2} m²), which Sentence 9.10.14.4.(7) permits."
    },
    {
      "id": "follows_open_air_garage",
      "state": "follows",
      "provision": "9.10.14.4.(8)",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "var": "occupancy"
              },
              "industrial"
            ]
          },
          {
            "op": "ge",
            "args": [
