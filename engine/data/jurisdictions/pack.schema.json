{
  "$defs": {
    "Authority": {
      "additionalProperties": false,
      "description": "The authority having jurisdiction is an organisation, not an officer (SCC IB-2026-10-16).\n\n`first_nation`, `federal`, `outside_alberta` and `unconfirmed` name who decides where the Safety Codes Act\nvariance does not, or where Batatis has not confirmed it; those packs are never `full` coverage.",
      "properties": {
        "contact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact"
        },
        "kind": {
          "enum": [
            "accredited_municipality",
            "alberta_safety_codes_authority",
            "accredited_organisation",
            "first_nation",
            "federal",
            "outside_alberta",
            "unconfirmed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reviewer_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The account `Authority` code when Batatis has reviewer accounts for this office; else null.",
          "title": "Reviewer Code"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PackSource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind",
        "sources"
      ],
      "title": "Authority",
      "type": "object"
    },
    "Bulletin": {
      "additionalProperties": false,
      "description": "A Safety Codes Council information bulletin. Title, date and link; paragraphs are not copied.",
      "properties": {
        "effective": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective"
        },
        "id": {
          "pattern": "^IB-\\d{4}-\\d{2}-\\d{2}$",
          "title": "Id",
          "type": "string"
        },
        "issued": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Issued",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PackSource"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "issued",
        "summary",
        "source"
      ],
      "title": "Bulletin",
      "type": "object"
    },
    "ChecklistCondition": {
      "additionalProperties": false,
      "description": "One operative condition. Plain language first; the source wording sits behind a disclosure.",
      "properties": {
        "group": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Group",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "scope",
            "construction",
            "agreement",
            "documents",
            "declaration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "may_not_apply": {
          "description": "False when the condition always applies to a project that uses the package.",
          "title": "May Not Apply",
          "type": "boolean"
        },
        "one_of": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Options of one choice share this key; the applicant follows one option and marks the others does not apply.",
          "title": "One Of"
        },
        "option": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The option this row belongs to within `one_of`, as the source labels it.",
          "title": "Option"
        },
        "plain": {
          "description": "Plain-language wording shown first.",
          "minLength": 12,
          "title": "Plain",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourcePointer"
        },
        "subject": {
          "description": "What the condition is about: both houses, one side, both parcels, the permit documents...",
          "enum": [
            "project",
            "both_houses",
            "zero_side",
            "easement_side",
            "both_parcels",
            "building",
            "each_house_with_suite",
            "permit_documents",
            "declaration"
          ],
          "title": "Subject",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plain-language trigger when the condition only applies in some designs.",
          "title": "When"
        }
      },
      "required": [
        "id",
        "group",
        "kind",
        "subject",
        "plain",
        "may_not_apply",
        "source"
      ],
      "title": "ChecklistCondition",
      "type": "object"
    },
    "ChecklistGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "plain": {
          "description": "One plain-language line under the group title.",
          "title": "Plain",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "plain"
      ],
      "title": "ChecklistGroup",
      "type": "object"
    },
    "CoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "enum": [
            "full",
            "code_only",
            "preview"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Z]{2}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "roadmap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roadmap"
        }
      },
      "required": [
        "id",
        "name",
        "coverage",
        "note"
      ],
      "title": "CoverageEntry",
      "type": "object"
    },
    "CoverageFile": {
      "additionalProperties": false,
      "properties": {
        "default_province": {
          "description": "Province whose fallback pack takes unmatched cases.",
          "pattern": "^[A-Z]{2}$",
          "title": "Default Province",
          "type": "string"
        },
        "levels": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "full",
              "code_only",
              "preview"
            ]
          },
          "title": "Levels",
          "type": "object"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/CoverageEntry"
          },
          "title": "Regions",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "default_province",
        "levels",
        "regions"
      ],
      "title": "CoverageFile",
      "type": "object"
    },
    "FormEntry": {
      "additionalProperties": false,
      "description": "A form the office expects. `role` says whether it is the province form or an additional local one.",
      "properties": {
        "export": {
          "description": "Whether Batatis fills this form today.",
          "enum": [
            "supported",
            "not_yet"
          ],
          "title": "Export",
          "type": "string"
        },
        "field_count": {
          "minimum": 0,
          "title": "Field Count",
          "type": "integer"
        },
        "field_map": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repository path of the field map, when export is supported.",
          "title": "Field Map"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Git-excluded local copy under reference/.",
          "title": "Local Path"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "page_count": {
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        },
        "pdf_last_modified": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Last Modified"
        },
        "role": {
          "enum": [
            "primary",
            "additional"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PackSource"
        },
        "status": {
          "enum": [
            "current",
            "confirm_with_office",
            "historical"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "issuer",
        "role",
        "version",
        "status",
        "export",
        "sha256",
        "page_count",
        "field_count",
        "source"
      ],
      "title": "FormEntry",
      "type": "object"
    },
    "Guide": {
      "additionalProperties": false,
      "description": "A published guide for a design category or process. Guidance, not a variance or an approval.",
      "properties": {
        "companions": {
          "items": {
            "$ref": "#/$defs/PackSource"
          },
          "title": "Companions",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "issued": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issued"
        },
        "requires_professional": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requires Professional"
        },
        "source": {
          "$ref": "#/$defs/PackSource"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "topic",
        "summary",
        "source"
      ],
      "title": "Guide",
      "type": "object"
    },
    "JurisdictionPack": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "bulletins": {
          "items": {
            "$ref": "#/$defs/Bulletin"
          },
          "title": "Bulletins",
          "type": "array"
        },
        "code_edition": {
          "title": "Code Edition",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "full",
            "code_only",
            "preview"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "fallback": {
          "default": false,
          "description": "The province pack used when no local pack matches.",
          "title": "Fallback",
          "type": "boolean"
        },
        "forms": {
          "items": {
            "$ref": "#/$defs/FormEntry"
          },
          "title": "Forms",
          "type": "array"
        },
        "guides": {
          "items": {
            "$ref": "#/$defs/Guide"
          },
          "title": "Guides",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/Match"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notices": {
          "items": {
            "$ref": "#/$defs/PackNotice"
          },
          "title": "Notices",
          "type": "array"
        },
        "process_notes": {
          "items": {
            "$ref": "#/$defs/ProcessNote"
          },
          "title": "Process Notes",
          "type": "array"
        },
        "province": {
          "pattern": "^[A-Z]{2}$",
          "title": "Province",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "standing_packages": {
          "items": {
            "$ref": "#/$defs/StandingPackage"
          },
          "title": "Standing Packages",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "province",
        "coverage",
        "code_edition",
        "summary",
        "authority"
      ],
      "title": "JurisdictionPack",
      "type": "object"
    },
    "Match": {
      "additionalProperties": false,
      "description": "How a case's jurisdiction resolves to this pack. Compared case-insensitively.",
      "properties": {
        "ids": {
          "items": {
            "type": "string"
          },
          "title": "Ids",
          "type": "array"
        },
        "names": {
          "items": {
            "type": "string"
          },
          "title": "Names",
          "type": "array"
        }
      },
      "title": "Match",
      "type": "object"
    },
    "PackNotice": {
      "additionalProperties": false,
      "description": "Information shown on the gaps list and the export. Severity is always info; it never blocks.",
      "properties": {
        "fix_hint": {
          "title": "Fix Hint",
          "type": "string"
        },
        "heading": {
          "description": "Appendix heading for the notice.",
          "title": "Heading",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "description": "ASCII, because it is also sent as an HTTP header.",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e]+$",
          "title": "Message",
          "type": "string"
        },
        "section": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "process"
          ],
          "title": "Section",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PackSource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "surfaces": {
          "items": {
            "enum": [
              "gaps",
              "export_header",
              "export_appendix"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Surfaces",
          "type": "array"
        }
      },
      "required": [
        "id",
        "surfaces",
        "section",
        "heading",
        "message",
        "fix_hint",
        "sources"
      ],
      "title": "PackNotice",
      "type": "object"
    },
    "PackSource": {
      "additionalProperties": false,
      "description": "Where a claim comes from. `retrieved` is the date the URL was fetched or checked.",
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "pages": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF pages that carry the claim, as printed by the reader, e.g. \"pp.2-3\".",
          "title": "Pages"
        },
        "retrieved": {
          "description": "Date the URL was fetched or checked (YYYY-MM-DD).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Retrieved",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the file fetched on `retrieved`.",
          "title": "Sha256"
        },
        "status": {
          "default": "verified",
          "description": "`unverified` when the claim could not be checked against the source.",
          "enum": [
            "verified",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "retrieved"
      ],
      "title": "PackSource",
      "type": "object"
    },
    "Place": {
      "additionalProperties": false,
      "description": "A place an applicant can name, and who reviews building work there. Generated by\n`python -m engine.jurisdictions.places_build`; one place becomes one pack unless a hand-written pack\nalready names it.",
      "properties": {
        "accreditation": {
          "description": "Safety Codes Council accreditation numbers held under this name.",
          "items": {
            "type": "string"
          },
          "title": "Accreditation",
          "type": "array"
        },
        "aliases": {
          "description": "Other names an applicant types, e.g. Red Deer.",
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "ask": {
          "description": "Who to ask, shown as the fix for a place that is not covered.",
          "minLength": 1,
          "title": "Ask",
          "type": "string"
        },
        "climate_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact NBC(AE) Table C-2 location name, if any.",
          "title": "Climate Location"
        },
        "code_edition": {
          "minLength": 1,
          "title": "Code Edition",
          "type": "string"
        },
        "covered": {
          "description": "True when Batatis prepares the application here; false means not covered.",
          "title": "Covered",
          "type": "boolean"
        },
        "id": {
          "description": "Pack id: the slug of the short name, e.g. red-deer.",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "accredited_municipality",
            "alberta_safety_codes_authority",
            "accredited_organisation",
            "first_nation",
            "federal",
            "outside_alberta",
            "unconfirmed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lg_code": {
          "anyOf": [
            {
              "pattern": "^\\d{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Municipal Affairs code, Alberta only.",
          "title": "Lg Code"
        },
        "name": {
          "description": "Legal name, e.g. City of Red Deer.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "description": "One plain sentence the applicant sees about who decides here.",
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "office": {
          "description": "Who reviews building work here.",
          "minLength": 1,
          "title": "Office",
          "type": "string"
        },
        "province": {
          "pattern": "^[A-Z]{2}$",
          "title": "Province",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PackSource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "type": {
          "description": "City, Town, First Nation, Airport lands, ...",
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "province",
        "type",
        "kind",
        "office",
        "covered",
        "code_edition",
        "note",
        "ask",
        "sources"
      ],
      "title": "Place",
      "type": "object"
    },
    "PlacesFile": {
      "additionalProperties": false,
      "description": "`places/<group>.json`: generated places for a province or for outside Alberta.",
      "properties": {
        "generated_by": {
          "title": "Generated By",
          "type": "string"
        },
        "group": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Group",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input file name to SHA-256 of the file the places were built from.",
          "title": "Inputs",
          "type": "object"
        },
        "places": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "minItems": 1,
          "title": "Places",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "group",
        "generated_by",
        "inputs",
        "places"
      ],
      "title": "PlacesFile",
      "type": "object"
    },
    "ProcessNote": {
      "additionalProperties": false,
      "description": "One administrative process claim. Never a technical or acceptance statement.",
      "properties": {
        "id": {
