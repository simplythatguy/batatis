        "plain": {
          "title": "Plain",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 260,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verified like a condition quote; null when the text is only in a figure.",
          "title": "Quote"
