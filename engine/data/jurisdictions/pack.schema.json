    "SourceNote": {
      "additionalProperties": false,
      "description": "Something in the source the applicant should know: an inconsistency, an offence warning, a figure-only note.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "conflict",
            "warning",
            "figure_only",
            "scope"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
