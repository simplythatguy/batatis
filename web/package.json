{
  "name": "batatis-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-types.mjs --check && tsc --noEmit && vite build",
    "gen:types": "node scripts/gen-types.mjs",
    "smoke:api": "node scripts/smoke-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test src/rules.test.ts src/professional.test.ts src/humanReview.test.ts src/identify.test.ts src/intake.test.ts src/visit.test.ts src/ui-notices.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
