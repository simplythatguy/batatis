{
  "name": "batatis-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-types.mjs --check && tsc --noEmit && vite build",
    "gen:types": "node scripts/gen-types.mjs",
    "smoke:api": "node scripts/smoke-api.ts",
    "test:check": "node tests/check.integration.mjs",
    "test:sync": "python3 scripts/test-sync.py",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test src/rules/rules.test.ts",
    "test:unwrap": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/unwrap-items.test.ts",
    "test": "node scripts/test-unit.mjs",
    "preview": "vite preview",
    "test:journey": "python3 scripts/test-journey.py"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
