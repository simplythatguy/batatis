#!/bin/sh
# Batatis: main changes only through pull requests. Rules: docs/agents/git-workflow.md
# Allowed: creating, fast-forwarding or deleting work branches, and deleting retired dev.
# Refused: every push to main, creating or updating dev, rewriting branches, tags and other refs.
zero=0000000000000000000000000000000000000000

refuse() {
  {
    echo "pre-push: refused. $1"
    echo "  To verify a work branch and open its pull request into main, run: scripts/land.sh"
    echo "  Rules: docs/agents/git-workflow.md"
  } >&2
  exit 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      refuse "main changes only when a pull request is merged on GitHub; run scripts/land.sh to open one."
      ;;
    refs/heads/dev)
      [ "$local_sha" = "$zero" ] && continue
      refuse "dev was retired; work on a short-lived branch instead."
      ;;
    refs/heads/*)
      [ "$local_sha" = "$zero" ] && continue
      [ "$remote_sha" = "$zero" ] && continue
      if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        refuse "the remote commit for '${remote_ref#refs/heads/}' is not available locally; fetch first."
      fi
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        refuse "this would rewrite '${remote_ref#refs/heads/}'; never force-push; merge origin/main or pull instead."
      fi
      ;;
    *)
      refuse "pushing $remote_ref is not allowed (no tags or other refs)."
      ;;
  esac
done
exit 0
